NODE_ENV=development
PORT=8000
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/gymease

# Generate independent, random secrets; do not use these names as values.
ACCESS_TOKEN_SECRET=<long-random-secret>
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=<different-long-random-secret>
REFRESH_TOKEN_EXPIRY=7d

# Required to authenticate scheduled-job endpoints.
CRON_SECRET=<long-random-secret>

# Optional integrations. Use sandbox/test credentials for a demo.
SAFEPAY_PUBLIC_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=

# Optional seed-admin overrides. Set a unique password before running the admin seed.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
